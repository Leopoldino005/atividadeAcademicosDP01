    <a class="btn btn-primary me-2" asp-controller="Aluno" asp-action="Index">Gerenciar alunos</a>
    <a class="btn btn-outline-primary" asp-controller="Instituicao" asp-action="Index">Gerenciar instituições</a>
</div>

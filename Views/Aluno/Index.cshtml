@model IEnumerable<Aluno>
@{ ViewData["Title"] = "Alunos"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1>Alunos</h1><a class="btn btn-primary" asp-action="Create">Novo aluno</a></div>
@if (TempData["Mensagem"] is string mensagem) { <div class="alert alert-success">@mensagem</div> }
@if (!Model.Any()) { <div class="alert alert-info">Nenhum aluno cadastrado.</div> }
else {
<table class="table table-striped table-hover">
<thead><tr><th>Nome</th><th>E-mail</th><th>Telefone</th><th>Município</th><th class="text-end">Ações</th></tr></thead>
<tbody>@foreach (var aluno in Model) { <tr><td>@aluno.Nome</td><td>@aluno.Email</td><td>@aluno.Telefone</td><td>@aluno.Municipio</td><td class="text-end text-nowrap"><a asp-action="Details" asp-route-id="@aluno.AlunoID">Detalhes</a> | <a asp-action="Edit" asp-route-id="@aluno.AlunoID">Editar</a> | <a asp-action="Delete" asp-route-id="@aluno.AlunoID" class="text-danger">Excluir</a></td></tr> }</tbody>
</table>
}
